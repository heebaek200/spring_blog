{{> layout/header}}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">

    <div class="card border-0 shadow-lg text-center p-4 p-md-5 rounded-4" style="max-width: 650px;">
        <div class="card-body">

            <div class="display-1 fw-bold text-primary mb-2">
                404
            </div>

            <p class="fs-5 text-secondary mb-4">
                요청하신 페이지를 찾을 수 없습니다.<br>
                주소가 변경되었거나 사라진 페이지일 수 있습니다.
            </p>

            <div class="alert alert-light border rounded-3 text-secondary mb-4">
                {{msg}}
            </div>

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a href="/" class="btn btn-primary btn-lg px-4">
                    메인페이지로 돌아가기
                </a>

                <button
                        type="button"
                        class="btn btn-outline-secondary btn-lg px-4"
                        onclick="history.back()">
                    이전 페이지
                </button>
            </div>

            <div class="mt-5 text-secondary small">
                <span class="badge text-bg-light border">
                    ERROR 404
                </span>
                <span class="ms-2">
                    Page Not Found
                </span>
            </div>

        </div>
    </div>

</div>

{{> layout/footer}}
{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>회원가입</b></div>
        <div class="card-body">
            {{! 파일을 보내려면 enctype가 반드시 multipart/form-data이어야 함 }}
            {{! 이메일 인증 이전에 submit을 막음. e.preventDefault도 좋지만, onsubmit으로 구현 }}
            <form action="/join" method="post" enctype="multipart/form-data" onsubmit="return checkVerify()">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="사용자명" name="username">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="비밀번호" name="password">
                </div>

                {{! 이메일 입력 + 인증번호 전송 버튼 }}
                <div class="mb-3">
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="이메일" name="email" id="email" required>
                        <button type="button" class="btn btn-outline-secondary" id="send-btn" onclick="sendCode()">인증번호 전송</button>
                    </div>
                </div>

                {{! 인증번호 입력 (처음엔 숨김, 발송 후 보여주기) }}
                <div class="mb-3" id="code-box" style="display: none;">
                    <div class="input-group">
                        <input type="text" class="form-control" id="code" placeholder="인증번호 입력" maxlength="">
                        <button type="button" class="btn btn-outline-secondary" onclick="verifyCode()">확인</button>
                    </div>

                    <div id="msg" class="form-text"></div>
                </div>

                <div class="mb-3">
                    <input type="file" class="form-control" id="profileImage" name="profileImage" accept="image/**">
                    <small>JPG, PNG, GIF, WEBP 파일만 올릴 수 있습니다.(선택사항)</small>
                </div>
                <button class="btn btn-primary form-control">회원가입</button>
            </form>
        </div>
    </div>
</div>

<script>
    // 인증 완료 여부 (화면 안내 용, 실제 검사는 서버의 세션으로 함)
    let isEmailVerified = false;
    // 1. 인증번호 전송
    async function sendCode() {
        const emailEl = document.querySelector("#email");
        const email = emailEl.value;   // 사용자 입력 : a@naver.com
        if (!email) {
            alert("이메일을 입력해주세요");
            emailEl.focus();
            return;
        }

        // 메일 발송은 오래 걸리므로, 버튼을 막아 중복 요청 방지
        const sendBtn = document.querySelector("#send-btn");
        sendBtn.disabled = true;
        sendBtn.innerHTML = "전송 중 ...";

        try {
            const response = await fetch("/api/email/send", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email
                })
            });

            const result = await response.json();
            alert(result.message);

            if (response.ok) {
                document.querySelector("#code-box").style.display = "block";
            }

        } catch (e) {
            console.error(e);
            alert("서버와 통신하지 못했습니다");
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerHTML = "인증번호 전송";
        }
    }

    // 2. 인증번호 확인 전송
    async function verifyCode() {
        // 사용자 이메일과 인증코드 6자리
        const email = document.querySelector("#email").value;
        const code = document.querySelector("#code").value;

        if (!code) {
            alert("인증번호를 입력해주세요");
            return;
        }

        try {
            const response = await fetch("/api/email/verify", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email: email,
                    code: code
                })
            });
            const result = await response.json();

            const msgBox = document.querySelector("#msg");
            if(response.ok) {
                isEmailVerified = true;
                msgBox.innerHTML = result.message;
                msgBox.className = "form-text text-success";
                // 인증한 이메일을 화면에서 바꾸지 못하게 잠금
                document.querySelector("#email").readOnly = true;
                document.querySelector("#send-btn").disabled = true;
            } else {
                msgBox.innerHTML = result.message;
                msgBox.className = "form-text text-danger";
            }

        } catch (e) {
            console.error(e);
            alert("서버와 통신하지 못했습니다.");
        }
    }

    // 회원가입 제출 직전 확인 (false를 반환하면 제출이 취소됨)
    function checkVerify() {
        if (!isEmailVerified) {
            alert("이메일 인증을 먼저 완료해주세요");
            return false;
        }

        return true;
    }

</script>

{{> layout/footer}}
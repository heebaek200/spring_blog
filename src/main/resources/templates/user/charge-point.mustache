{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><h4 class="mb-0"><b>포인트 충전</b></h4></div>
        <div class="card-body">
            <div class="mb-4">
                <label class="form-label fw-bold mb-3">충전할 포인트 선택</label>
                <!--  이벤트 위임 방식으로 수정 -->
                <div class="row g-3" id="point-btn-group">
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="1000">1,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="5000">5,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="10000">10,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="20000">20,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="50000">50,000 P</button></div>
                    <div class="col-md-4"><button type="button" class="btn btn-outline-primary w-100 point-btn" data-amount="100000">100,000 P</button></div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">충전 예정 금액</label>
                <p class="form-control-plaintext">
                    <span class="badge bg-success fs-5" id="selected-amount">0</span> P
                </p>
            </div>

            <div class="d-grid gap-2">
                <button type="button" class="btn btn-primary" id="charge-btn" disabled>충전하기</button>
                <a href="/user/detail" class="btn btn-secondary">취소</a>
            </div>
        </div>
    </div>
</div>

{{! 포트원 SDK }}
<script src="https://cdn.portone.io/v2/browser-sdk.js"></script>
<script>
    let selectedAmount = 0;
    const pointButtons = document.querySelectorAll("#point-btn-group .point-btn");
    const amountDisplay = document.querySelector("#selected-amount");
    const chargeButton = document.querySelector("#charge-btn");

    // 이벤트 위임 (버블링) 사용
    const pointBtnGroup = document.querySelector("#point-btn-group");
    pointBtnGroup.addEventListener("click", event => {
        // 클릭한 곳에서 가장 가까운 .point-btn 찾기
        const btn = event.target.closest(".point-btn");

        pointButtons.forEach(otherBtn => otherBtn.classList.remove("active"));
        btn.classList.add("active");

        selectedAmount = Number(btn.dataset.amount);
        amountDisplay.innerText = selectedAmount.toLocaleString();
        chargeButton.disabled = false;
    });

    // 충전 버튼 클릭 시 -> [1] 우리 서버(주문서 생성)   [2] 포트원 결제창   [3] 결제 완료 처리
    chargeButton.addEventListener("click", async () => {
        if (selectedAmount <= 0) return;
        chargeButton.disabled = true; // 중복 클릭 방지

        try {
            // 우리 서버에 결제 생성
            const prepareResponse = await fetch("/api/payment/prepare", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    amount: selectedAmount
                })
            });

            const prepare = await prepareResponse.json();

            if (! prepareResponse.ok) {
                alert("잘못된 요청입니다.");
            }

            // 포트원 결제창 호출 (카카오페이 간편결제)
            const paymentRes = await PortOne.requestPayment({
                // Store ID 설정
                storeId: prepare["storeId"],
                // 채널 키 설정
                channelKey: prepare["channelKey"],
                paymentId: prepare["paymentId"],
                orderName: "포인트 충전",
                totalAmount: prepare["amount"],
                currency: "CURRENCY_KRW",
                payMethod: "EASY_PAY",
            });

            console.log(paymentRes);

            // 결제 실패나 취소 시 응답에 code 포함
            if (! paymentRes || paymentRes.code !== undefined) {
                alert("결제가 완료되지 않았습니다.");
            }

            // 서버 검증 요청
            const completeRes = await fetch("/api/payment/complete", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    paymentId: paymentRes.paymentId
                })
            });

            const result = await completeRes.json();
            if (! completeRes.ok) {
                alert("포인트 충전에 실패했습니다.");
            }

            alert(`충전이 완료되었습니다.
충전 금액 : ${result.amount.toLocaleString()}
현재 보유 포인트 : ${result.currentPoint.toLocaleString()}
`);
            location.href = "/user/detail";
        } catch (e) {
            alert(`${e.message} : 서버와 통신하지 못했습니다.`);
        } finally {
            chargeButton.disabled = false;
        }
    });

</script>

{{> layout/footer}}
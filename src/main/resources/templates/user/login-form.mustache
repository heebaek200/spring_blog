{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>로그인</b></div>
        <div class="card-body">
            <form action="/login" method="post">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="사용자명" name="username" value="minsu">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="비밀번호" name="password" value="1234">
                </div>
                <button class="btn btn-primary form-control">로그인</button>
                
                <div class="text-center mt-3">
                    <a href="/kakao-login">
                        <img src="/img/kakao_login_kr_small.png" alt="">
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}